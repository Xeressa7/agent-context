#!/bin/sh
# yapit-memory pre-commit — bilgi-kalitesi kapisi.
#
# Dogrulama mantigi BURADA YASAMAZ: tek motor `ctx validate`'tir; bu kanca
# yalnizca onu cagirir. Ayni motoru `ctx doctor` da kullanir.
#
# Git = kalicilik kapisi · ctx validate = bilgi-kalitesi kapisi.
# Bu kanca yalnizca ikincisini commit anina baglar; working tree'deki bozuk
# notu yakalamaz — onun icin `ctx validate` elle ya da doctor uzerinden kosar.
#
# Kurulum: git config core.hooksPath .githooks
# Atlatma (bilerek): git commit --no-verify

CTX_PY="$HOME/.agent-context/bin/ctx.py"

if [ ! -f "$CTX_PY" ]; then
  echo "pre-commit: ctx bulunamadi ($CTX_PY) — dogrulama ATLANDI." >&2
  exit 0
fi

if command -v python >/dev/null 2>&1; then
  PY=python
elif command -v python3 >/dev/null 2>&1; then
  PY=python3
else
  echo "pre-commit: Python bulunamadi — dogrulama ATLANDI." >&2
  exit 0
fi

echo "pre-commit: ctx validate --tam koşuyor..."
if ! "$PY" "$CTX_PY" validate --tam --memory "$(git rev-parse --show-toplevel)"; then
  echo "" >&2
  echo "pre-commit: HATA bulundu, commit durduruldu." >&2
  echo "  Duzelt ve tekrar dene; bilerek atlamak icin: git commit --no-verify" >&2
  exit 1
fi

# Not ekleyip/silip elle commit edildiginde tuketici repolardaki her-zaman-yuklu
# harita bayatlar (ajan yolunda bunu `ctx close --not` otomatik tazeler). Bu kanca
# tuketicileri BILMEZ — yalnizca hatirlatir; kontrol `ctx doctor`da.
if git diff --cached --name-only | grep -qE '\.md$'; then
  echo "pre-commit: not degisti — tuketici repoda 'ctx index --yaz' calistirmayi unutma."
fi

exit 0
